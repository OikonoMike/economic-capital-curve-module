# PostgreSQL: настройки контейнера и общей инфраструктуры
POSTGRES_DB=irrbb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example_password
POSTGRES_PORT=5432

# Пароли пользователей приложения (db/init/02_roles.sh)
