# PostgreSQL: настройки контейнера и общей инфраструктуры
POSTGRES_DB=irrbb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example_password
POSTGRES_PORT=5433

# Пароли пользователей приложения (db/init/02_roles.sh)
LOADER_PASSWORD=loader_secret
CALC_PASSWORD=calc_secret

# Подключение загрузчика к PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=irrbb
DB_USER=loader_rw
DATABASE_URL=

# Инициатор запуска (необязательно)
STARTED_BY=

# Calculator API (От Команды 1)
CALCULATOR_API_URL=
CALCULATOR_API_KEY=
USE_CALCULATOR_STUB=true

# Подключение API к PostgreSQL (только чтение)
API_DB_HOST=localhost
API_DB_PORT=5433
API_DB_NAME=irrbb
API_DB_USER=calc_ro
API_DB_PASSWORD=calc_secret

# Автозагрузка по API. Для закрытого стенда укажите DSN роли loader_rw.
CURVES_INGEST_DATABASE_URL=
